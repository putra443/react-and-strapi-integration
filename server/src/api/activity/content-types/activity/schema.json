{
  "kind": "collectionType",
  "collectionName": "activities",
  "info": {
    "singularName": "activity",
    "pluralName": "activities",
    "displayName": "activities"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "desc": {
      "type": "text"
    },
    "img": {
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ],
      "type": "media",
      "multiple": false
    },
    "alumniName": {
      "type": "string"
    },
    "alumniId": {
      "type": "biginteger"
    },
    "eventType": {
      "type": "enumeration",
      "enum": [
        "Seminar",
        "Social Project",
        "Workshop",
        "Gathering",
        "Networking"
      ]
    },
    "participantCount": {
      "type": "biginteger"
    },
    "location": {
      "type": "text"
    },
    "date": {
      "type": "date"
    }
  }
}
